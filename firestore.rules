rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────────
    // Authentication & Authorization Helpers
    // ─────────────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Trusted Admin check:
    // 1. Custom claims: request.auth.token.role == 'admin' (set securely via Admin SDK)
    // 2. Verified admin email domain from auth token
    // 3. User document role == 'admin' (strictly protected against customer tampering)
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'admin' ||
        (request.auth.token.email != null && (
          request.auth.token.email == 'admin@aquapure.com' ||
          request.auth.token.email.matches('^[a-zA-Z0-9._%+-]+@aquapure[.]com$')
        )) ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
        )
      );
    }

    // ─────────────────────────────────────────────
    // Users Collection
    // ─────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      
      // On creation:
      // - Must match caller's auth UID
      // - Non-admin cannot assign role == 'admin'
      // - Allowed roles for self-registration: 'customer' or 'dealer' with dealerStatus == 'pending'
      allow create: if isAdmin() || (
        isOwner(userId) &&
        (!('uid' in request.resource.data) || request.resource.data.uid == userId) &&
        (
          (!('role' in request.resource.data) || request.resource.data.role == 'customer') ||
          (request.resource.data.role == 'dealer' && request.resource.data.dealerStatus == 'pending')
        )
      );
      
      // On update:
      // - Admins can update any field (including role and dealer approval)
      // - Regular users can update their profile fields (name, phone, addresses, etc.)
      // - Regular users CANNOT escalate their role or approve dealer status or change uid
      allow update: if isAdmin() || (
        isOwner(userId) &&
        (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']) ||
          ('role' in resource.data && request.resource.data.role == resource.data.role)
        ) &&
        (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['dealerStatus']) ||
          ('dealerStatus' in resource.data && request.resource.data.dealerStatus == resource.data.dealerStatus)
        ) &&
        (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['uid']) ||
          request.resource.data.uid == userId
        )
      );
      
      allow delete: if isAdmin();
    }

    // ─────────────────────────────────────────────
    // Products Collection (Store Catalog)
    // ─────────────────────────────────────────────
    match /products/{productId} {
      // Public catalog read access for all users/visitors
      allow read: if true;
      
      // Admin-only creation and modification with schema validation
      allow create, update: if isAdmin() &&
        (!('name' in request.resource.data) || (request.resource.data.name is string && request.resource.data.name.size() > 0)) &&
        (!('customerPrice' in request.resource.data) || (request.resource.data.customerPrice is number && request.resource.data.customerPrice >= 0)) &&
        (!('active' in request.resource.data) || request.resource.data.active is bool);
        
      allow delete: if isAdmin();
    }

    // ─────────────────────────────────────────────
    // Orders Collection
    // ─────────────────────────────────────────────
    match /orders/{orderId} {
      allow read: if isAdmin() || (
        isAuthenticated() && (
          resource.data.customerId == request.auth.uid ||
          (resource.data.dealerId != null && resource.data.dealerId == request.auth.uid)
        )
      );
      
      // Order Creation:
      // - Must be authenticated
      // - customerId must match caller's UID
      // - Valid subtotal and total numbers (non-negative)
      // - If items is present, must be a non-empty list
      // - If orderStatus is present, initial status must be 'placed'
      allow create: if isAuthenticated() &&
        request.resource.data.customerId == request.auth.uid &&
        (!('orderStatus' in request.resource.data) || request.resource.data.orderStatus == 'placed') &&
        (!('total' in request.resource.data) || (request.resource.data.total is number && request.resource.data.total >= 0)) &&
        (!('items' in request.resource.data) || (request.resource.data.items is list && request.resource.data.items.size() > 0));

      // Order Updates:
      // - Admins can advance status or manage orders
      // - Customers/dealers can cancel an order that is currently 'placed'
      // - Customers/dealers can confirm delivery receipt ('delivered') when order is in-flight
      allow update: if isAdmin() || (
        (isOwner(resource.data.customerId) || (resource.data.dealerId != null && isOwner(resource.data.dealerId))) &&
        (
          // Allow customer/dealer to cancel an order that is placed
          (
            resource.data.orderStatus == 'placed' &&
            request.resource.data.orderStatus == 'cancelled'
          ) ||
          // Allow customer/dealer to confirm delivery receipt
          (
            (resource.data.orderStatus == 'shipped' || resource.data.orderStatus == 'out_for_delivery' || resource.data.orderStatus == 'confirmed') &&
            request.resource.data.orderStatus == 'delivered'
          )
        ) &&
        request.resource.data.customerId == resource.data.customerId &&
        (!('total' in resource.data) || request.resource.data.total == resource.data.total) &&
        (!('items' in resource.data) || request.resource.data.items == resource.data.items)
      );

      allow delete: if isAdmin();
    }

    // ─────────────────────────────────────────────
    // Service Bookings Collection
    // ─────────────────────────────────────────────
    match /service_bookings/{bookingId} {
      allow read: if isAdmin() || (
        isAuthenticated() && resource.data.userId == request.auth.uid
      );
      
      // Booking Creation:
      // - Must be authenticated
      // - userId must match caller's UID
      // - If status is present, initial status must be 'requested'
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid &&
        (!('status' in request.resource.data) || request.resource.data.status == 'requested') &&
        (!('serviceType' in request.resource.data) || request.resource.data.serviceType is string) &&
        (!('address' in request.resource.data) || request.resource.data.address is map);

      // Booking Updates:
      // - Admins can advance status or manage tickets
      // - Users can only cancel a booking that is currently 'requested'
      allow update: if isAdmin() || (
        isOwner(resource.data.userId) &&
        resource.data.status == 'requested' &&
        request.resource.data.status == 'cancelled' &&
        request.resource.data.userId == resource.data.userId &&
        (!('serviceType' in resource.data) || request.resource.data.serviceType == resource.data.serviceType)
      );

      allow delete: if isAdmin();
    }
  }
}
