# AquaPure Firebase Cloud Functions & Mail Server Environment Configuration
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_test_secret_here
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# Gmail SMTP Configuration for Order & Service Email Notifications
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your_16_character_app_password
MAIL_SERVER_PORT=5055

# Firebase Configuration (for Firestore Order Email Watcher)
FIREBASE_API_KEY=your-api-key-here
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=your-sender-id
FIREBASE_APP_ID=your-app-id

# Admin Credentials for Order Watcher
ADMIN_EMAIL=admin@aquapure.com
ADMIN_PASSWORD=your_admin_password
